# Copiá este archivo como .env (run.sh lo hace solo). El .env NUNCA se sube al repo.
# Con LLM_PROVIDER=mock el sistema corre completo sin ninguna API key.

# --- LLM: mock | openai | google ---
LLM_PROVIDER=mock
# LLM_MODEL=                     # vacío = modelo por defecto del proveedor
# LLM_REQUESTS_PER_MINUTE=4      # solo si usás el plan gratuito de Gemini
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- RAG: embeddings y vector store ---
EMBEDDING_PROVIDER=local         # local | openai | google
# EMBEDDING_MODEL=
EMBEDDING_DIMENSION=256          # local=256; openai/google=1536 (debe coincidir con el índice)
VECTOR_BACKEND=memory            # memory | pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=intelligence-kb
PINECONE_NAMESPACE=productos-es
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
RAG_TOP_K=5
RAG_BM25_WEIGHT=0.5
RAG_VECTOR_WEIGHT=0.5

# --- Redis Stack (cola, estado de jobs y checkpoints de LangGraph) ---
REDIS_URL=redis://localhost:6379

# --- Observabilidad: Arize Phoenix ---
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=intelligence-system
PHOENIX_ENABLED=true

# --- Workers ---
WORKER_CONCURRENCY=5
JOB_TIMEOUT_S=600
LOG_LEVEL=INFO
