config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	supervisor(supervisor)
	investigador(investigador)
	analista(analista)
	validacion(validacion)
	aprobacion_humana(aprobacion_humana)
	ejecutar_accion(ejecutar_accion)
	sintetizador(sintetizador)
	__end__([<p>__end__</p>]):::last
	__start__ --> supervisor;
	analista --> supervisor;
	aprobacion_humana -.-> __end__;
	aprobacion_humana -.-> ejecutar_accion;
	aprobacion_humana -.-> sintetizador;
	ejecutar_accion --> sintetizador;
	investigador --> supervisor;
	supervisor -.-> analista;
	supervisor -.-> investigador;
	supervisor -.-> validacion;
	validacion -. &nbsp;sintetizador&nbsp; .-> aprobacion_humana;
	validacion -.-> supervisor;
	sintetizador --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
